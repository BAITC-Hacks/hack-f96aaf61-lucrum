# Set to the backend origin to use the documented integration contract.
# Leave unset to use the clearly labeled synthetic development mock.
VITE_API_BASE_URL=http://localhost:8000
# In development, the Vite server proxies /api to this backend so browser CORS is not required.
# Set VITE_API_PROXY=false only when the backend explicitly allows cross-origin browser requests.
VITE_API_PROXY=true
